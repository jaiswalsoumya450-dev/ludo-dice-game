<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DIE THROW</title>
  <link rel="icon" type="image/png" href="/dice.avif">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    const NODE_ENV = "<%= NODE_ENV %>";
    const MISC_BASE_URL = "<%= MISC_BASE_URL %>";
  </script>
  <style>
    body {
      background: radial-gradient(ellipse at 50% 35%, #1e3799 0%, #0a1628 65%);
      min-height: 100vh;
      overflow: hidden;
    }

    .die-letter {
      font-family: 'Fredoka One', cursive;
      font-size: 9rem;
      line-height: 1;
      display: inline-block;
      filter: drop-shadow(0 6px 0 rgba(0,0,0,0.35));
    }

    #popup-overlay,
    #pub-popup-overlay,
    #pri-popup-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.65);
      z-index: 50;
      align-items: center;
      justify-content: center;
    }
    #popup-overlay.open,
    #pub-popup-overlay.open,
    #pri-popup-overlay.open { display: flex; }
  </style>
</head>
<body class="min-h-screen text-white relative">

  <!-- Top bar -->
  <div class="fixed top-0 left-0 right-0 flex justify-between items-center px-5 py-4 z-10">

    <!-- Name / profile button -->
    <button id="name-btn" class="flex items-center gap-2 bg-black bg-opacity-40 border border-gray-700 rounded-full px-3 py-2 hover:bg-opacity-60 transition">
      <div id="avatar-initial" class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center font-bold text-sm"></div>
      <span id="display-name" class="text-white font-medium text-sm"></span>
      <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>

    <!-- Chips + Logout -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 bg-black bg-opacity-40 border border-yellow-600 rounded-full px-4 py-2">
        <span class="text-lg leading-none">🪙</span>
        <span id="chips-display" class="text-yellow-400 font-bold text-sm tracking-wide">–</span>
      </div>
      <button onclick="logout()" class="flex items-center gap-2 bg-black bg-opacity-40 border border-red-500 text-red-400 rounded-full px-4 py-2 text-sm font-medium hover:bg-red-900 hover:bg-opacity-30 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Logout
      </button>
    </div>
  </div>

  <!-- Center content -->
  <div class="flex flex-col items-center justify-center min-h-screen gap-2">

    <!-- DIE-THROW -->
    <div class="flex select-none" style="gap:0.15rem;">
      <span class="die-letter" style="color:#ef4444;">D</span>
      <span class="die-letter" style="color:#f97316;">I</span>
      <span class="die-letter" style="color:#22c55e;">E</span>
      <span class="die-letter" style="color:#14b8a6;">—</span>
      <span class="die-letter" style="color:#14b8a6;">T</span>
      <span class="die-letter" style="color:#ef4444;">H</span>
      <span class="die-letter" style="color:#f97316;">R</span>
      <span class="die-letter" style="color:#22c55e;">O</span>
      <span class="die-letter" style="color:#14b8a6;">W</span>
      <span class="die-letter" style="color:#ef4444;">!</span>
    </div>
    
    <!-- Divider -->
    <div class="flex items-center gap-3 w-56 my-3">
      <hr class="flex-1 border-gray-600">
      <hr class="flex-1 border-gray-600">
    </div>

    <!-- Game mode buttons -->
    <div class="flex gap-6">
      <button id="public-mode" class="w-60 h-40 bg-green-500 hover:bg-green-400 rounded-2xl flex flex-col items-center justify-center gap-2 transition shadow-lg">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="2"/>
            <path stroke-linecap="round" stroke-width="2" d="M12 8v8M8 12h8"/>
          </svg>
          <span class="font-extrabold text-2xl">Public</span>
        </div>
        <span class="text-green-100 text-sm">Join open matches!</span>
      </button>

      <button id="private-mode" class="w-60 h-40 bg-purple-600 hover:bg-purple-500 rounded-2xl flex flex-col items-center justify-center gap-2 transition shadow-lg">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="5" y="11" width="14" height="10" rx="2" stroke-width="2"/>
            <path stroke-linecap="round" stroke-width="2" d="M8 11V7a4 4 0 018 0v4"/>
          </svg>
          <span class="font-extrabold text-2xl">Private</span>
        </div>
        <span class="text-purple-100 text-sm">Play with friends!</span>
      </button>
    </div>
  </div>

  <!-- Profile popup -->
  <div id="popup-overlay">
    <div id="popup-card" class="bg-gray-900 border border-gray-700 rounded-2xl p-8 w-80 flex flex-col items-center gap-5 relative">
      <button id="close-popup" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg leading-none">✕</button>
      <h2 class="text-white font-bold text-xl">Profile</h2>

      <div id="popup-avatar" class="w-16 h-16 rounded-full bg-orange-500 flex items-center justify-center font-bold text-2xl"></div>

      <div class="w-full">
        <label class="text-gray-400 text-xs mb-1 block uppercase tracking-wide">Name</label>
        <input id="popup-name" type="text"
          class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"/>
      </div>

      <p id="popup-msg" class="text-red-400 text-sm hidden"></p>

      <button id="save-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg text-sm transition">
        Save
      </button>

      <button id="delete-account-btn" class="w-full bg-red-700 hover:bg-red-600 text-white font-semibold py-2 rounded-lg text-sm transition">
        Delete Account
      </button>
    </div>
  </div>

  <!-- Public Game popup -->
  <div id="pub-popup-overlay" class="modal-pub">
    <div id="pub-popup-card" class="bg-gray-900 border border-gray-700 rounded-2xl p-8 w-80 flex flex-col items-center gap-5 relative">
      <button id="pub-close-popup" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg leading-none">✕</button>
      <h2 class="text-white font-bold text-xl">Multiplayer Game</h2>

      <div class="w-full">
        <label for="pub-max-players" class="text-gray-400 text-xs mb-1 block uppercase tracking-wide">Maximum Players</label>
        <select id="pub-max-players"
          class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500">
          <option selected value="2">2 players</option>
          <option value="4">4 players</option>
        </select>
      </div>

      <div class="w-full">
        <label for="pub-lobby-amt" class="text-gray-400 text-xs mb-1 block uppercase tracking-wide">Lobby Amount</label>
        <select id="pub-lobby-amt"
          class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500">
          <option value="0" selected>0 chips</option>
          <option value="500">500 chips</option>
          <option value="1000">1000 chips</option>
        </select>
      </div>

      <p id="pub-popup-msg" class="text-red-400 text-sm hidden"></p>

      <button id="play-pub-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg text-sm transition">
        Play!
      </button>
      
    </div>
  </div>

  <!-- Private Game popup -->
  <div id="pri-popup-overlay">
    <div id="pri-popup-card" class="bg-gray-900 border border-gray-700 rounded-2xl p-8 w-80 flex flex-col items-center gap-5 relative">
      <button id="pri-close-popup" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg leading-none">✕</button>
      <h2 class="text-white font-bold text-xl">Private Game</h2>

      <!--TODO first option not showing as the default selected option-->
      <div class="w-full">
        <label for="pri-max-players" class="text-gray-400 text-xs mb-1 block uppercase tracking-wide">Maximum Players</label>
        <select id="pri-max-players"
          class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
          <option value="2" selected>2 players</option>
          <option value="4">4 players</option>
        </select>
      </div>

      <div class="w-full">
        <label for="pri-lobby-amt" class="text-gray-400 text-xs mb-1 block uppercase tracking-wide">Lobby Amount</label>
        <select id="pri-lobby-amt"
          class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
          <option value="0">0 chips</option>
          <option value="500">500 chips</option>
          <option value="1000">1000 chips</option>
        </select>
      </div>

      <p id="pri-popup-msg" class="text-red-400 text-sm hidden"></p>

      <button id="play-pri-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg text-sm transition">
        Play!
      </button>
      
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="/js/constants.js"></script>
  <script src="/v1/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
